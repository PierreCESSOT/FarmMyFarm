<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="controllers.Market"
        style="-fx-background-color: #1a1a2e;">

    <!-- BARRE DU HAUT -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #16213e; -fx-border-color: #f59e0b; -fx-border-width: 0 0 2 0; -fx-padding: 12 20 12 20;">

            <Button text="← Ferme" onAction="#goToFarm"
                    style="-fx-background-color: #4ade80; -fx-text-fill: #1a1a2e; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 7 16 7 16; -fx-background-radius: 6; -fx-cursor: hand;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="🛒 MARCHÉ"
                   style="-fx-text-fill: #f59e0b; -fx-font-size: 22px; -fx-font-weight: bold; -fx-font-family: 'Consolas';"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblMoney" text="💰 1000 pièces"
                   style="-fx-text-fill: #fef3c7; -fx-font-size: 15px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="30" style="-fx-padding: 30;">

            <!-- ═══════════ SECTION ACHAT GRAINES ═══════════ -->
            <Label text="🌱 ACHETER DES GRAINES"
                   style="-fx-text-fill: #4ade80; -fx-font-size: 15px; -fx-font-weight: bold; -fx-font-family: 'Consolas';"/>

            <HBox alignment="CENTER" spacing="30">

                <!-- Carte achat Patate -->
                <VBox alignment="CENTER" spacing="12"
                      style="-fx-background-color: #1e293b; -fx-border-color: #92400e; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 24 36 24 36;">
                    <Label text="🥔" style="-fx-font-size: 40px;"/>
                    <Label text="GRAINE DE PATATE"
                           style="-fx-text-fill: #fef3c7; -fx-font-size: 14px; -fx-font-weight: bold; -fx-font-family: 'Consolas';"/>
                    <Label fx:id="lblPatateSeeds" text="Graines : 0"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                    <Label text="Coût : 50 pièces / graine"
                           style="-fx-text-fill: #f59e0b; -fx-font-size: 12px;"/>
                    <Button fx:id="btnBuyPatate" text="Acheter 1 graine"
                            style="-fx-background-color: #92400e; -fx-text-fill: #fef3c7; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20 8 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </VBox>

                <!-- Carte achat Maïs -->
                <VBox alignment="CENTER" spacing="12"
                      style="-fx-background-color: #1e293b; -fx-border-color: #365314; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 24 36 24 36;">
                    <Label text="🌽" style="-fx-font-size: 40px;"/>
                    <Label text="GRAINE DE MAÏS"
                           style="-fx-text-fill: #d9f99d; -fx-font-size: 14px; -fx-font-weight: bold; -fx-font-family: 'Consolas';"/>
                    <Label fx:id="lblMaisSeeds" text="Graines : 0"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                    <Label text="Coût : 100 pièces / graine"
                           style="-fx-text-fill: #f59e0b; -fx-font-size: 12px;"/>
                    <Button fx:id="btnBuyMais" text="Acheter 1 graine"
                            style="-fx-background-color: #365314; -fx-text-fill: #d9f99d; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20 8 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </VBox>

            </HBox>

            <Separator style="-fx-background-color: #334155;"/>

            <!-- ═══════════ SECTION VENTE RÉCOLTE ═══════════ -->
            <Label text="💰 VENDRE MA RÉCOLTE"
                   style="-fx-text-fill: #f59e0b; -fx-font-size: 15px; -fx-font-weight: bold; -fx-font-family: 'Consolas';"/>

            <HBox alignment="CENTER" spacing="30">

                <!-- Carte vente Patate -->
                <VBox alignment="CENTER" spacing="12"
                      style="-fx-background-color: #1e293b; -fx-border-color: #92400e; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 24 36 24 36;">
                    <Label text="🥔" style="-fx-font-size: 40px;"/>
                    <Label text="PATATE"
                           style="-fx-text-fill: #fef3c7; -fx-font-size: 14px; -fx-font-weight: bold; -fx-font-family: 'Consolas';"/>
                    <Label fx:id="lblPatateStock" text="Récolte : 0"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                    <Label text="Prix : 100 pièces / unité"
                           style="-fx-text-fill: #4ade80; -fx-font-size: 12px;"/>
                    <Button fx:id="btnSellPatate" text="Vendre tout"
                            style="-fx-background-color: #92400e; -fx-text-fill: #fef3c7; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20 8 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </VBox>

                <!-- Carte vente Maïs -->
                <VBox alignment="CENTER" spacing="12"
                      style="-fx-background-color: #1e293b; -fx-border-color: #365314; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 24 36 24 36;">
                    <Label text="🌽" style="-fx-font-size: 40px;"/>
                    <Label text="MAÏS"
                           style="-fx-text-fill: #d9f99d; -fx-font-size: 14px; -fx-font-weight: bold; -fx-font-family: 'Consolas';"/>
                    <Label fx:id="lblMaisStock" text="Récolte : 0"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                    <Label text="Prix : 300 pièces / unité"
                           style="-fx-text-fill: #4ade80; -fx-font-size: 12px;"/>
                    <Button fx:id="btnSellMais" text="Vendre tout"
                            style="-fx-background-color: #365314; -fx-text-fill: #d9f99d; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20 8 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </VBox>

            </HBox>

            <!-- Statut -->
            <Label fx:id="lblMarketStatus" text=""
                   style="-fx-text-fill: #4ade80; -fx-font-size: 13px; -fx-font-style: italic;"/>

        </VBox>
    </center>

</BorderPane>
